<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF252D44"
                android:endColor="#FF141826" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_stat_kitsune" />
</layer-list>
